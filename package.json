{
  "name": "@mr.mm/opencode-omniroute-plugin",
  "version": "0.1.2",
  "description": "OpenCode plugin for the OmniRoute AI Gateway. Drives dynamic model discovery, /connect auth flow, and multi-instance OmniRoute providers via the official @opencode-ai/plugin contract.",
  "type": "module",
  "main": "./plugin/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./plugin/index.cjs"
    },
    "./library": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "plugin"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "bun --test tests/*.test.ts",
    "release": "bun run clean && bun run build && bun run test && npm publish",
    "prepublishOnly": "bun run clean && bun run build && bun test tests/"
  },
  "keywords": [
    "omniroute",
    "opencode",
    "opencode-plugin",
    "ai-sdk",
    "openai-compatible",
    "provider",
    "gemini",
    "combos",
    "mcp"
  ],
  "author": "OmniRoute contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrmm/opencode-omniroute-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/mrmm/opencode-omniroute-plugin/issues"
  },
  "homepage": "https://github.com/mrmm/opencode-omniroute-plugin#readme",
  "engines": {
    "node": ">=22",
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.6",
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
